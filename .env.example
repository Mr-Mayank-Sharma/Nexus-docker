# =============================================================================
# Nexus OMS — Production Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in ALL required values before starting.
#   cp .env.example .env
# Generate strong secrets with:  openssl rand -base64 48
# NEVER commit the real .env file (it is gitignored).
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Required — no default)
# -----------------------------------------------------------------------------
DB_PASSWORD=change_me_strong_db_password

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION (Required — no default, must be >= 32 chars)
#   Generate: openssl rand -base64 48
# -----------------------------------------------------------------------------
JWT_SECRET=change_me_jwt_secret_at_least_32_chars_long

# -----------------------------------------------------------------------------
# GRAFANA (Required — no default)
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password

# -----------------------------------------------------------------------------
# SPRING PROFILE (Recommended: prod for hardened production config)
#   Options: default | prod | ai
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# -----------------------------------------------------------------------------
# CORS / FRONTEND (Required for the frontend to reach the API)
#   Comma-separated list of allowed origins.
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost

# -----------------------------------------------------------------------------
# AI SERVICES (Required for AI features)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NEXUS_AI_ENABLED=false

# -----------------------------------------------------------------------------
# CARRIER API CREDENTIALS (Required for shipping — fill as needed)
# -----------------------------------------------------------------------------
# FedEx
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
# UPS
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
# USPS
USPS_USER_ID=
USPS_PASSWORD=
# DHL
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=

# -----------------------------------------------------------------------------
# S3 / MINIO (Document storage & shipping labels)
# NOTE: The backend's StorageService requires the AmazonS3 bean, which the app
# enables by default (storage.s3.enabled matchIfMissing=true). Keep this true;
# the S3 client is created lazily and does not connect at startup. Point
# S3_ENDPOINT at a real S3/MinIO service to actually use storage.
# -----------------------------------------------------------------------------
NEXUS_S3_ENABLED=true
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nexus-shipping-labels
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# SSO PROVIDERS (Optional — for OAuth2/SSO login)
# -----------------------------------------------------------------------------
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Okta
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_DOMAIN=
# Auth0
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DOMAIN=

# -----------------------------------------------------------------------------
# ADMIN USER (Required for seed scripts)
# -----------------------------------------------------------------------------
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS (Optional — have safe defaults)
# -----------------------------------------------------------------------------
# Server port
PORT=8080
# Kafka listener auto-start
NEXUS_KAFKA_LISTENER_AUTO_START=true
# Redis health check in actuator
NEXUS_REDIS_HEALTH_ENABLED=false
# Cache enabled (Redis-backed in prod)
NEXUS_CACHE_ENABLED=true
# Flyway baseline on migrate
FLYWAY_BASELINE_ON_MIGRATE=true
# JWT expiration (ms)
NEXUS_JWT_EXPIRATION_MS=900000
# Log level
NEXUS_LOG_LEVEL=INFO
